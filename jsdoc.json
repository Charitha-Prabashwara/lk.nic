{
    "source":{
        "include":["src"],
        "inculdePattern": ".js$",
        "excludePattern": "(node_modules/|docs)"
    },
    "plugins": ["plugins/markdown"],
    "templates":{
        "cleverLinks":true,
        "monospaceLinks":true
    },
    "opts":{
        "recurse":true,
        "destination": "./docs/",
        "template": "node_modules/docdash",
        "readme": "README.md",
        "encoding": "utf8"
    }
}